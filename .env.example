# MongoDB connection string for the Smart Shop Hub app
# For a local MongoDB instance, use:
# MONGODB_URI=mongodb://127.0.0.1:27017/smartshophub

# For hosted MongoDB Atlas, use your cluster connection string.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartshophub?retryWrites=true&w=majority

# JWT secret used to sign auth tokens
JWT_SECRET=smart_shop_hub_super_secret_key
